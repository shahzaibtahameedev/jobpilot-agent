{
  "name": "jb-agent",
  "version": "1.0.0",
  "description": "AI-powered pipeline that finds LinkedIn hiring posts and emails recruiters with your resume",
  "type": "module",
  "private": true,
  "scripts": {
    "app": "npm run build:client && npm run server",
    "server": "tsx src/server/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "npm start --prefix client",
    "build:client": "npm run build --prefix client",
    "start": "tsx src/index.ts",
    "login": "tsx src/index.ts login",
    "scrape": "tsx src/index.ts scrape",
    "audit": "tsx src/index.ts audit",
    "write-emails": "tsx src/index.ts write",
    "send": "tsx src/index.ts send",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@hono/node-server": "^2.1.8",
    "@playwright/mcp": "^0.0.83",
    "dotenv": "^18.0.9",
    "hono": "^4.13.18",
    "nodemailer": "^10.3.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
